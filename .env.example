# Used by the reproducible reranking experiment.
COHERE_API_KEY=

# Reserved for refactoring the legacy application away from local key files.
OPENROUTER_API_KEY=
OPENROUTER_TITLE_MODEL=anthropic/claude-haiku-4.5
SCRAPINGANT_API_KEY=

# OpenSearch connection. Local docker-compose disables security for development.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_SHARDS=1
OPENSEARCH_INDEX_REPLICAS=0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
